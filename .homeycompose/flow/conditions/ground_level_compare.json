            "nl": "lager dan"
          }
        },
        {
          "id": "lte",
          "label": {
            "en": "lower than or equal",
            "nl": "lager dan of gelijk aan"
          }
        },
        {
          "id": "gt",
          "label": {
            "en": "greater than",
            "nl": "hoger dan"
          }
        },
        {
          "id": "gte",
          "label": {
            "en": "greater than or equal",
            "nl": "hoger dan of gelijk aan"
          }
        }
      ]
    },
    {
      "type": "number",
      "name": "value",
      "placeholder": {
        "en": "Level",
        "nl": "Niveau"
      }
