{
  "title": {
    "en": "Set fan speed with timer",
    "nl": "Stel ventilatorsnelheid in met timer"
  },
  "titleFormatted": {
    "en": "Set fan speed to [[speed]] rpm for [[timer]] minutes",
    "nl": "Stel ventilatorsnelheid in op [[speed]] rpm voor [[timer]] minuten"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=nrgwatch_itho_cve"
    },
    {
      "type": "number",
      "name": "speed",
      "min": 0,
      "max": 3000,
      "placeholder": {
        "en": "Speed (rpm)",
        "nl": "Snelheid (rpm)"
      }
    },
    {
      "type": "number",
      "name": "timer",
      "min": 1,
      "max": 1440,
      "placeholder": {
        "en": "Minutes",
        "nl": "Minuten"
      }
    }
  ]
}
