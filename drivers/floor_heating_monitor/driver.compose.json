{
  "name": {
    "en": "Floor Heating Monitor",
    "nl": "Vloerverwarming Monitor"
  },
  "class": "sensor",
  "icon": "{{driverAssetsPath}}/icon.svg",
  "capabilities": [
    "measure_temperature.flow",
    "measure_temperature.return",
    "measure_temperature.delta"
  ],
  "capabilitiesOptions": {
    "measure_temperature.flow": {
      "title": {
        "en": "Flow Temperature (In)",
        "nl": "Aanvoertemperatuur (In)"
      }
    },
    "measure_temperature.return": {
      "title": {
        "en": "Return Temperature (Out)",
        "nl": "Retourtemperatuur (Uit)"
      }
    },
    "measure_temperature.delta": {
      "title": {
        "en": "Delta T (Δt)",
        "nl": "Delta T (Δt)"
      }
    }
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "/drivers/floor_heating_monitor/assets/images/small.png",
    "large": "/drivers/floor_heating_monitor/assets/images/large.png",
    "xlarge": "/drivers/floor_heating_monitor/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "MQTT Settings",
        "nl": "MQTT Instellingen"
      },
      "children": [
        {
          "id": "mqtt_topic",
          "type": "text",
          "label": {
            "en": "MQTT Topic",
            "nl": "MQTT Onderwerp"
          },
          "value": "heating/floor1/status",
          "hint": {
            "en": "The MQTT topic to subscribe to for floor heating data. Expected JSON format: {\"flow\": 35.2, \"return\": 28.5} where 'flow' is the flow/supply temperature and 'return' is the return temperature in °C",
            "nl": "Het MQTT onderwerp om te abonneren voor vloerverwarmingsgegevens. Verwacht JSON formaat: {\"flow\": 35.2, \"return\": 28.5} waarbij 'flow' de aanvoertemperatuur is en 'return' de retourtemperatuur in °C"
          }
        }
      ]
    }
  ]
}
