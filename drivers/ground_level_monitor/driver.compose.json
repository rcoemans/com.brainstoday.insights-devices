{
  "name": {
    "en": "Ground Level Monitor",
    "nl": "Grondniveau Monitor"
  },
  "class": "sensor",
  "icon": "{{driverAssetsPath}}/icon.svg",
  "capabilities": [
    "ground_level"
  ],
  "capabilitiesOptions": {
    "ground_level": {
      "title": {
        "en": "Ground Level",
        "nl": "Grondniveau"
      }
    }
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "/drivers/ground_level_monitor/assets/images/small.png",
    "large": "/drivers/ground_level_monitor/assets/images/large.png",
    "xlarge": "/drivers/ground_level_monitor/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "MQTT Settings",
        "nl": "MQTT Instellingen"
      },
      "children": [
        {
          "id": "mqtt_topic",
          "type": "text",
          "label": {
            "en": "MQTT Topic",
            "nl": "MQTT Onderwerp"
          },
          "value": "sensor/crawlSpaceHeight",
          "hint": {
            "en": "The MQTT topic to subscribe to for ground level data. Expected payload: a single numeric value (e.g. 42.5 representing cm)",
            "nl": "Het MQTT onderwerp om te abonneren voor grondniveaugegevens. Verwachte payload: een enkele numerieke waarde (bijv. 42.5 voor cm)"
          }
        },
        {
          "id": "unit",
          "type": "text",
          "label": {
            "en": "Unit",
            "nl": "Eenheid"
          },
          "value": "cm",
          "hint": {
            "en": "Measurement unit (e.g., cm, m)",
            "nl": "Meeteenheid (bijv. cm, m)"
          }
        },
        {
          "id": "alarm_threshold",
          "type": "number",
          "label": {
            "en": "Alarm Threshold (optional)",
            "nl": "Alarmdrempel (optioneel)"
          },
          "value": 0,
          "hint": {
            "en": "Trigger alarm when level exceeds this value (0 = disabled)",
            "nl": "Activeer alarm wanneer niveau deze waarde overschrijdt (0 = uitgeschakeld)"
          }
        }
      ]
    }
  ]
}
