{
  "name": {
    "en": "Custom MQTT Sensor",
    "nl": "Aangepaste MQTT Sensor"
  },
  "class": "sensor",
  "icon": "{{driverAssetsPath}}/icon.svg",
  "capabilities": [],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "/drivers/custom_mqtt_sensor/assets/images/small.png",
    "large": "/drivers/custom_mqtt_sensor/assets/images/large.png",
    "xlarge": "/drivers/custom_mqtt_sensor/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "MQTT Settings",
        "nl": "MQTT Instellingen"
      },
      "children": [
        {
          "id": "mqtt_topic",
          "type": "text",
          "label": {
            "en": "MQTT Topic",
            "nl": "MQTT Onderwerp"
          },
          "value": "",
          "hint": {
            "en": "The MQTT topic to subscribe to. Example: sensor/crawlSpaceHeight or itho/lastcmd",
            "nl": "Het MQTT onderwerp om op te abonneren. Voorbeeld: sensor/crawlSpaceHeight of itho/lastcmd"
          }
        },
        {
          "id": "payload_type",
          "type": "dropdown",
          "label": {
            "en": "Payload Type",
            "nl": "Payload Type"
          },
          "value": "number",
          "hint": {
            "en": "Single Number: payload is just a number (e.g. 42.5). JSON Object: payload is a JSON object (e.g. {\"temp\":22.9}). JSON Array: payload is a JSON array (e.g. [22.9, 39.3]).",
            "nl": "Enkel Getal: payload is een getal (bijv. 42.5). JSON Object: payload is een JSON object (bijv. {\"temp\":22.9}). JSON Array: payload is een JSON array (bijv. [22.9, 39.3])."
          },
          "values": [
            {
              "id": "number",
              "label": {
                "en": "Single Number",
                "nl": "Enkel Getal"
              }
            },
            {
              "id": "json_object",
              "label": {
                "en": "JSON Object",
                "nl": "JSON Object"
              }
            },
            {
              "id": "json_array",
              "label": {
                "en": "JSON Array",
                "nl": "JSON Array"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Number Value 1",
        "nl": "Getalwaarde 1"
      },
      "children": [
        {
          "id": "number_1_path",
          "type": "text",
          "label": {
            "en": "JSON Path",
            "nl": "JSON Pad"
          },
          "value": "",
          "hint": {
            "en": "Leave empty to disable this slot. For 'Single Number': leave empty or enter 'value'. For 'JSON Object': enter the key name, e.g. 'temp' or 'data.temperature' for nested. For 'JSON Array': enter the index, e.g. '0'.",
            "nl": "Laat leeg om dit slot uit te schakelen. Voor 'Enkel Getal': laat leeg of voer 'value' in. Voor 'JSON Object': voer de sleutelnaam in, bijv. 'temp' of 'data.temperature' voor genest. Voor 'JSON Array': voer de index in, bijv. '0'."
          }
        },
        {
          "id": "number_1_label",
          "type": "text",
          "label": {
            "en": "Display Label",
            "nl": "Weergavenaam"
          },
          "value": "",
          "hint": {
            "en": "Name shown on the device card, e.g. 'Ground Level' or 'Temperature'",
            "nl": "Naam op de apparaatkaart, bijv. 'Grondniveau' of 'Temperatuur'"
          }
        },
        {
          "id": "number_1_unit",
          "type": "text",
          "label": {
            "en": "Unit",
            "nl": "Eenheid"
          },
          "value": "",
          "hint": {
            "en": "Measurement unit shown after the value, e.g. 'cm', '°C', 'rpm', '%'",
            "nl": "Meeteenheid na de waarde, bijv. 'cm', '°C', 'rpm', '%'"
          }
        },
        {
          "id": "number_1_decimals",
          "type": "number",
          "label": {
            "en": "Decimal Places",
            "nl": "Decimalen"
          },
          "value": 1,
          "min": 0,
          "max": 5,
          "hint": {
            "en": "Number of decimal places to show (0-5)",
            "nl": "Aantal decimalen om weer te geven (0-5)"
          }
        }
      ]
    },
